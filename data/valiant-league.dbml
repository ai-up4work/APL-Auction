// APL Auction Platform Schema
// Generated for dbdiagram.io
// Note: auth.users is Supabase's built-in auth table, referenced but not defined here.

//////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////

Enum auction_status {
  setup
  live
  paused
  completed
}

Enum team_tier {
  A
  B
  C
  Pro
  Elite
  Legend
}

Enum player_role {
  "Batter"
  "Bowler"
  "All-rounder"
  "WK-Batter"
  "Batsman"
  "Wicket Keeper"
}

Enum player_origin {
  local
  overseas
  Local
  Overseas
}

Enum player_bank_origin {
  Local
  Overseas
}

Enum lot_status {
  shuffling
  pending
  sold
  unsold
}

Enum feedback_role {
  owner
  auctioneer
  spectator
}

Enum feedback_trigger {
  paused
  completed
}

Enum access_mode_enum {
  private
  spectator
  broadcast
}

Enum tournament_format {
  single_elimination
  double_elimination
  round_robin
}

Enum tournament_category {
  Auction
  Bracket
  Overlay
  League
}

Enum bracket_type_enum {
  winners
  losers
  grand_final
  round_robin
}

Enum bracket_status {
  upcoming
  live
  completed
}

Enum result_source_enum {
  overlay
  manual
}

//////////////////////////////////////////////
// TABLES
//////////////////////////////////////////////

Table organizations {
  id uuid [pk, default: `uuid_generate_v4()`]
  name text [not null]
  slug text [not null, unique]
  description text
  logo_url text
  created_by uuid [not null]
  plan text [not null, default: 'free']
  status text [not null, default: 'active']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table user_profiles {
  id uuid [pk]
  email text [not null]
  full_name text
  avatar_url text
  current_org_id uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  username text [not null, unique]
  bio text
  banner_url text

  Note: 'id references auth.users(id)'
}

Table org_memberships {
  id uuid [pk, default: `uuid_generate_v4()`]
  org_id uuid [not null]
  user_id uuid [not null]
  role text [not null, default: 'viewer']
  status text [not null, default: 'active']
  invited_at timestamptz [default: `now()`]
  joined_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'user_id references auth.users(id)'
}

Table tournaments {
  id uuid [pk, default: `gen_random_uuid()`]
  org_id uuid [not null]
  name text [not null]
  format tournament_format [not null]
  status text [not null, default: 'setup']
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  category tournament_category
  description text
  image_url text
  start_date date
  prize_pool text
  website text
  twitter text
  discord text
  logo_url text

  Note: 'created_by references auth.users(id)'
}

Table tournament_activity {
  id uuid [pk, default: `gen_random_uuid()`]
  tournament_id uuid [not null]
  event_type text [not null]
  actor_id uuid
  payload jsonb
  created_at timestamptz [default: `now()`]
}

Table tournament_prizes {
  id uuid [pk, default: `gen_random_uuid()`]
  tournament_id uuid [not null]
  place text [not null]
  reward text [not null]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table tournament_awards {
  id uuid [pk, default: `gen_random_uuid()`]
  tournament_id uuid [not null]
  label text [not null]
  team_id uuid
  player_name text [not null]
  note text
  awarded_at timestamptz [not null, default: `now()`]
}

Table auctions {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, default: 'APL Season 1']
  status auction_status [not null, default: 'setup']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  launched_at timestamptz
  completed_at timestamptz
  org_id uuid
  created_by uuid
  tournament_id uuid
  tournament_opt_out boolean [not null, default: false]
  is_synthetic boolean [not null, default: false]

  Note: 'created_by references auth.users(id)'
}

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid [not null]
  code text [not null]
  name text [not null]
  tier team_tier [not null, default: 'Pro']
  owner text [not null]
  color text [not null, default: '#e45d35']
  logo text [default: '']
  roster integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  remaining_purse integer [default: 50000]
  pin text [not null, default: '000000']
}

Table players {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid [not null]
  name text [not null]
  role player_role [not null]
  origin player_origin [not null, default: 'Local']
  price integer [not null, default: 500]
  capped boolean [not null, default: false]
  img text [default: '']
  country text [default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  sold_to_team_id uuid
  sold_price integer
  status text [default: 'available']
  lot_order integer
  owner_team_code text
  reentry_count integer [default: 0]
  is_unsold_final boolean [default: false]
  is_unsold boolean [default: false]
  is_captain boolean [not null, default: false]
  is_manual_entry boolean [not null, default: false]
}

Table rules {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid [not null, unique]
  total_points integer [not null, default: 50000]
  team_size integer [not null, default: 16]
  base_price integer [not null, default: 500]
  owner_participation boolean [not null, default: true]
  owner_self_purchase_cost integer [not null, default: 3000]
  max_overseas_players integer [not null, default: 0]
  reserve_points_enforced boolean [not null, default: true]
  max_bid_time_seconds integer [not null, default: 300]
  unsold_reentry_rounds integer [not null, default: 1]
  tiers jsonb [not null, default: `'[{"to": 1000, "from": 500, "increment": 100}, {"to": 3000, "from": 1000, "increment": 200}, {"to": 6000, "from": 3000, "increment": 500}, {"to": 20000, "from": 6000, "increment": 1000}, {"to": null, "from": 20000, "increment": 2000}]'`]
  updated_at timestamptz [not null, default: `now()`]
  target_player_count integer [not null, default: 140]
  current_round integer [default: 0]
}

Table session_config {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid [not null, unique]
  auction_name text [not null, default: 'APL Season 1 Auction']
  auctioneer text [default: '']
  auction_date text [default: '']
  auction_time text [default: '']
  venue text [default: '']
  timer_seconds integer [not null, default: 15]
  access_mode access_mode_enum [not null, default: 'spectator']
  spectator_link text [default: 'apl-auction.live/watch/s1']
  owner_participation boolean [not null, default: true]
  unsold_reintroduce boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]
  auction_logo text
}

Table auction_lots {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid
  player_id uuid
  lot_number integer [not null, default: 1]
  status lot_status [not null, default: 'pending']
  current_bid integer [not null, default: 0]
  base_price integer [not null, default: 500]
  winning_team_id uuid
  winning_team_code text
  started_at timestamptz [default: `now()`]
  closed_at timestamptz
  player_country text
  player_img text
  player_name text
  player_role text
}

Table bid_history {
  id uuid [pk, default: `gen_random_uuid()`]
  lot_id uuid
  auction_id uuid
  team_id uuid
  team_code text
  team_name text
  team_color text
  amount integer [not null]
  placed_at timestamptz [not null, default: `now()`]
}

Table feedback {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid [not null]
  team_id uuid
  role feedback_role [not null, default: 'spectator']
  trigger feedback_trigger [not null, default: 'completed']
  rating integer [note: 'CHECK rating >= 1 AND rating <= 5']
  what_went_well text
  what_to_improve text
  submitted_at timestamptz [not null, default: `now()`]
}

Table standings {
  id uuid [pk, default: `gen_random_uuid()`]
  auction_id uuid
  team_id uuid [not null]
  played smallint [not null, default: 0]
  won smallint [not null, default: 0]
  lost smallint [not null, default: 0]
  tied smallint [not null, default: 0]
  no_result smallint [not null, default: 0]
  points smallint [not null, default: 0]
  runs_scored integer [not null, default: 0]
  balls_faced integer [not null, default: 0]
  runs_conceded integer [not null, default: 0]
  balls_bowled integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
  tournament_id uuid
  nrr decimal [not null, default: 0]
  form jsonb [not null, default: `'[]'`]
}

Table bracket_matches {
  id uuid [pk, default: `gen_random_uuid()`]
  tournament_id uuid [not null]
  bracket_type bracket_type_enum [not null, default: 'winners']
